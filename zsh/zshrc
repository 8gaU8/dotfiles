# ========= custom hook to auto-compile zsh scripts ============
# ref: https://zenn.dev/fuzmare/articles/zsh-source-zcompile-all
function source {
	# attempt to compile the first argument if it's an existing file
	if [[ -f "$1" ]]; then
		ensure_zcompiled "$1"
	fi
	
	# "$@" を使って、2つ目以降の引数も含めて全てbuiltinに渡す
	builtin source "$@"
}

function ensure_zcompiled {
	local target="$1"
	local compiled="${target}.zwc"
	if [[ ! -r "$compiled" || "$target" -nt "$compiled" ]]; then
		zcompile "$target"
	fi
}

# compile zshrc itself
ensure_zcompiled "${HOME}/.zshrc"


autoload -Uz compinit && compinit -C

# ---- BOOTSTRAP ----
# Activate mise
if [ -z "${VSCODE_INJECTION}" ]; then
	eval "$(${HOME}/.local/bin/mise activate zsh)"
else
	eval "$(${HOME}/.local/bin/mise activate zsh --shims)"
fi

# sheldon init
eval "$(sheldon source)"


# ---- Bundle local plugins ----
local DOTFILES_DIR="${HOME}/dotfiles"
local bundle_file="${DOTFILES_DIR}/zsh/custom.bundle.zsh"

# Generate bundled file when it doesn't exist
if [[ ! -f "$bundle_file" ]]; then

	# Concatenate scripts sequentially
	for f in "${DOTFILES_DIR}/zsh/local-plugins"/[0-9][0-9]-*.zsh; do
		[[ -e "$f" ]] || continue
		
		echo "  Appending $f..."
		{
			echo "# --- Source: ${f} ---"
			echo "{ # --- try block start ---"
			cat "$f"
			echo "} 2>/dev/null || true # --- catch block ---"
			echo
		} >> "${bundle_file}"
	done

	echo "✅ Bundle created: ${bundle_file}"
fi
source "$bundle_file"

unfunction source
