{
  "profiles": [
    {
      "complex_modifications": {
        "parameters": {
          "basic.simultaneous_threshold_milliseconds": 50,
          "basic.to_delayed_action_delay_milliseconds": 500,
          "basic.to_if_alone_timeout_milliseconds": 1000,
          "basic.to_if_held_down_threshold_milliseconds": 500,
          "mouse_motion_to_scroll.speed": 100
        },
        "rules": [
          {
            "description": "左コントロールが単独で押された時, 英数+ESCに置き換え. ホールド時は左Ctrl",
            "manipulators": [
              {
                "from": {
                  "key_code": "left_control",
                  "modifiers": {
                    "mandatory": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "left_control"
                  }
                ],
                "to_if_alone": [
                  {
                    "key_code": "escape"
                  }
                ],
                "to_if_held_down": [
                  {
                    "key_code": "left_control"
                  }
                ],
                "type": "basic"
              }
            ]
          },
          {
            "description": "[fn]Key + Digit Key sends F* ; e.g. 'fn'+'3' -> 'F3', , 'fn+'0' -> 'F10', 'fn'+'=' -> 'F12'",
            "manipulators": [
              {
                "from": {
                  "key_code": "1",
                  "modifiers": {
                    "mandatory": ["fn"],
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "f1"
                  }
                ],
                "type": "basic"
              },
