          {
            "description": "コマンドキーを単体で押したときに、英数・かなキーを送信する。（左コマンドキーは英数、右コマンドキーはかな） (rev 3)",
            "manipulators": [
              {
                "from": {
                  "key_code": "left_command",
                  "modifiers": {
                    "mandatory": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "left_command",
                    "lazy": true
                  }
                ],
                "to_if_alone": [
                  {
                    "key_code": "japanese_eisuu"
                  }
                ],
                "to_if_held_down": [
                  {
                    "key_code": "left_command"
                  }
                ],
                "type": "basic"
              },
              {
                "from": {
                  "key_code": "right_command",
                  "modifiers": {
                    "mandatory": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "right_command",
                    "lazy": true
                  }
